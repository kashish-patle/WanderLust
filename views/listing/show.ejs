
<% layout("/layouts/boilerplate") %>

<div class="show-container">

    <h2 class="show-heading"><%= listing.title %></h2>

    <div class="card show-card">

        <img
            src="<%= listing.image.url %>"
            class="show-card-img"
            alt="Listing Image"
        >

        <div class="card-body show-card-body">
             
            <p>
                <i class="fa-solid fa-user"></i>
                <i><b><%= listing.owner.username %> </b>--(Owner Of Property)</i>
            </p>
                            

            <p class="show-description">
                <%= listing.description %>
            </p>

            <hr>

            <p>
                <i class="fa-solid fa-location-dot"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>

            <h5 class="show-price">
                ₹ <%= listing.price.toLocaleString("en-IN") %>
                <span>/ night</span>
            </h5>

            
                 <div class="show-actions">
                    <a href="/listings/<%= listing._id %>/edit"
                    class="btn add-listing-btn">
                        <i class="fa-solid fa-pen"></i> Edit Listing
                    </a>

                    <form method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="fa-solid fa-trash"></i> Delete Listing
                        </button>
                    </form>
                </div>
            

        </div>
    </div>

    <a href="/listings" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Back to all listings
    </a>

    
    <hr>

    <div class="col-8 offset-3">
        <h4>Leave a Review</h4>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

            <div class="mb-3">
                <label for="rating" class="form-label">Your Rating:</label>

                <input
                    type="range"
                    min="1"
                    max="5"
                    value="3"
                    class="form-range"
                    id="rating"
                    name="review[rating]"
                >
            </div>

            <div class="mb-3">
                <label for="comment" class="form-label">Your Comment:</label>

                <textarea
                    id="comment"
                    name="review[comment]"
                    class="form-control"
                    rows="4"
                    required
                ></textarea>
                <div class="invalid-feedback"> Please submit some feedback.</div>
            </div>

            <button type="submit" class="btn btn-primary">
                Submit Review
            </button>

        </form>
    </div>

    <hr>

    <h4>All Reviews</h4>

    <div class="row">
        <% for (let review of listing.reviews) { %>
            <div class="card col-5 ms-3 mb-3">
                <div class="card-body">
                    <h4>John Doe</h4>
                    <h5 class="card-title">Rating: <%= review.rating %> / 5</h5>

                    <p class="card-text">
                        <%= review.comment %>
                    </p>

                    <p class="text-muted">
                        <%= review.createdAt.toDateString() %>
                    </p>
                </div>
                <form mb-3 method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                   <button class="btn btn-sm btn-dark">Delete</button> 
                </form>
            </div>
        <% } %>
    </div>


</div>
