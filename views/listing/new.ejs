<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WonderLust</title>
</head>
<body>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings">
        <input type="text" name="listing[title]" placeholder="Enter title">
        <br/><br/>
        <input type="text" name="listing[description]" placeholder="Enter description">
        <br/><br/>
        <input type="text" name="listing[image][url]" placeholder="Enter image URL">
        <br/><br/>
        <input type="number" name="listing[price]" placeholder="Enter price">
        <br/><br/> 
        <input type="text" name="listing[location]" placeholder="Enter location">
        <br/><br/>
        <input type="text" name="listing[country]" placeholder="Enter country">
        <br/><br/>
        <button type="submit">Add Listing</button>
    </form>
</body>
</html>