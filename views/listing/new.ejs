



<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-md-8 col-lg-6 mx-auto">
        <div class="form-container">

            <h2 class="form-heading">Add New Listing</h2>
            <p class="form-subheading">Share your place with the world!</p>

            <form method="POST" action="/listings"
                  novalidate class="needs-validation">

                <!-- Title -->
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text"
                           name="listing[title]"
                           class="form-control"
                           placeholder="Enter listing title"
                           required
                           minlength="3"
                           maxlength="100">
                    <div class="invalid-feedback">
                        Title must be at least 3 characters.
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="listing[description]"
                              class="form-control"
                              rows="4"
                              placeholder="Describe your property"
                              required
                              minlength="10"></textarea>
                    <div class="invalid-feedback">
                        Description must be at least 10 characters.
                    </div>
                </div>

                <!-- Image -->
                <div class="mb-3">
                    <label class="form-label">Image URL</label>
                    <input type="url"
                           name="listing[image][url]"
                           class="form-control"
                           placeholder="Paste image URL">
                    <div class="invalid-feedback">
                        Please enter a valid image URL.
                    </div>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label class="form-label">Price per night (₹)</label>
                    <input type="text"
                        name="listing[price]"
                        class="form-control"
                        placeholder="Enter price"
                        inputmode="numeric"
                        pattern="[0-9]+"
                        min="1"
                        required>

                    
                </div>

                <div class="row">

                    <!-- Location -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Location</label>
                        <input type="text"
                               name="listing[location]"
                               class="form-control"
                               placeholder="Enter city"
                               required>
                        <div class="invalid-feedback">
                            Please enter a location.
                        </div>
                    </div>

                    <!-- Country -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Country</label>
                        <input type="text"
                               name="listing[country]"
                               class="form-control"
                               placeholder="Enter country"
                               required>
                        <div class="invalid-feedback">
                            Please enter a country.
                        </div>
                    </div>

                </div>

                <button type="submit" class="btn add-listing-btn w-100">
                    Add Listing
                </button>

            </form>
        </div>
    </div>
</div>

