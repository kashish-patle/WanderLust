<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flash Messages</title>
</head>
<body>

    <h1>Hello, <%= name %>!</h1>

    <% if (success.length > 0) { %>
        <p style="color: green;">
            <%= success[0] %>
        </p>
    <% } %>

    <% if (error.length > 0) { %>
        <p style="color: red;">
            <%= error[0] %>
        </p>
    <% } %>

</body>
</html>